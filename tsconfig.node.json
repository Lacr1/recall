{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["electron.vite.config.ts", "vitest*.config.ts", "src/main/**/*", "src/preload/**/*", "src/engine/**/*", "src/shared/**/*", "tests/**/*"],
  "exclude": ["tests/fixtures/**", "tests/.tmp/**"]
}
